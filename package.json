{
  "name": "repomap",
  "version": "0.1.0",
  "description": "Visual interactive map of any code repository — buildings=files, streets=dependencies, heatmap=git churn",
  "type": "module",
  "bin": {
    "repomap": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "repository",
    "visualization",
    "code-map",
    "architecture",
    "dependencies",
    "git-churn",
    "cli"
  ],
  "author": "Lucas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucas/repomap"
  },
  "bugs": {
    "url": "https://github.com/lucas/repomap/issues"
  },
  "homepage": "https://github.com/lucas/repomap#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "d3": "^7.8.5",
    "glob": "^10.3.10",
    "jsdom": "^24.0.0",
    "ora": "^7.0.1",
    "simple-git": "^3.22.0",
    "ts-morph": "^20.0.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
